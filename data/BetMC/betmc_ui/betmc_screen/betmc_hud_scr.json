 "betmc_mainhand_durability_label@betmc_hud.betmc_hud_label": {
    "$betmc_font_scale_factor": 0.65,
    "text": "#text",
    "layer": 5,
    "bindings": [
      {
        "binding_name": "#item_durability_current_amount",
        "binding_type": "collection",
        "binding_collection_name": "hotbar_items"
      },
      {
        "binding_name": "#item_durability_total_amount",
        "binding_name_override": "#betmc_total_durability_00",
        "binding_type": "collection",
        "binding_collection_name": "hotbar_items"
      },
      {
        "binding_name": "#slot_selected",
        "binding_type": "collection",
        "binding_collection_name": "hotbar_items"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#slot_selected and (not (#betmc_total_durability_00 = 0)))",
        "target_property_name": "#visible"
      },
      {
        "binding_type": "view",      // BETMC CURRENT DURABILITY
        "source_property_name": "(#item_durability_current_amount * ( 1 - ((#item_durability_current_amount < 0) * 2)))",
        "target_property_name": "#betmc_current_durability_00"
      },
      {
        "binding_type": "view",
        "source_property_name": "(10000 * ((#betmc_current_durability_00 > 19999) + (#betmc_current_durability_00 > 29999) + (#betmc_current_durability_00 > 39999) + (#betmc_current_durability_00 > 49999) + (#betmc_current_durability_00 > 59999) + (#betmc_current_durability_00 > 69999) + (#betmc_current_durability_00 > 79999) + (#betmc_current_durability_00 > 89999) + (#betmc_current_durability_00 > 9999)))",
        "target_property_name": "#betmc_current_durability_1"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#betmc_current_durability_00 - #betmc_current_durability_1)",
        "target_property_name": "#betmc_current_durability_10"
      },
      {
        "binding_type": "view",
        "source_property_name": "(1000 * ((#betmc_current_durability_10 > 1999) + (#betmc_current_durability_10 > 2999) + (#betmc_current_durability_10 > 3999) + (#betmc_current_durability_10 > 4999) + (#betmc_current_durability_10 > 5999) + (#betmc_current_durability_10 > 6999) + (#betmc_current_durability_10 > 7999) + (#betmc_current_durability_10 > 8999) + (#betmc_current_durability_10 > 999)))",
        "target_property_name": "#betmc_current_durability_2"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#betmc_current_durability_10 - #betmc_current_durability_2)",
        "target_property_name": "#betmc_current_durability_20"
      },
      {
        "binding_type": "view",
        "source_property_name": "(100 * ((#betmc_current_durability_20 > 199) + (#betmc_current_durability_20 > 299) + (#betmc_current_durability_20 > 399) + (#betmc_current_durability_20 > 499) + (#betmc_current_durability_20 > 599) + (#betmc_current_durability_20 > 699) + (#betmc_current_durability_20 > 799) + (#betmc_current_durability_20 > 899) + (#betmc_current_durability_20 > 99)))",
        "target_property_name": "#betmc_current_durability_3"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#betmc_current_durability_20 - #betmc_current_durability_3)",
        "target_property_name": "#betmc_current_durability_30"
      },
      {
        "binding_type": "view",
        "source_property_name": "(10 * ((#betmc_current_durability_30 > 19) + (#betmc_current_durability_30 > 29) + (#betmc_current_durability_30 > 39) + (#betmc_current_durability_30 > 49) + (#betmc_current_durability_30 > 59) + (#betmc_current_durability_30 > 69) + (#betmc_current_durability_30 > 79) + (#betmc_current_durability_30 > 89) + (#betmc_current_durability_30 > 9)))",
        "target_property_name": "#betmc_current_durability_4"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#betmc_current_durability_30 - #betmc_current_durability_4)",
        "target_property_name": "#betmc_current_durability_40"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#betmc_current_durability_40 > 1) + (#betmc_current_durability_40 > 2) + (#betmc_current_durability_40 > 3) + (#betmc_current_durability_40 > 4) + (#betmc_current_durability_40 > 5) + (#betmc_current_durability_40 > 6) + (#betmc_current_durability_40 > 7) + (#betmc_current_durability_40 > 8) + (#betmc_current_durability_40 > 0))",
        "target_property_name": "#betmc_current_durability_5"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#betmc_current_durability_1 + #betmc_current_durability_2 + #betmc_current_durability_3 + #betmc_current_durability_4 + #betmc_current_durability_5) * ( 1 - ((#item_durability_current_amount < 0) * 2)))",
        "target_property_name": "#betmc_current_durability_value"
      },
      {
        "binding_type": "view",      // BETMC TOTAL DURABILITY
        "source_property_name": "(10000 * ((#betmc_total_durability_00 > 19999) + (#betmc_total_durability_00 > 29999) + (#betmc_total_durability_00 > 39999) + (#betmc_total_durability_00 > 49999) + (#betmc_total_durability_00 > 59999) + (#betmc_total_durability_00 > 69999) + (#betmc_total_durability_00 > 79999) + (#betmc_total_durability_00 > 89999) + (#betmc_total_durability_00 > 9999)))",
        "target_property_name": "#betmc_total_durability_1"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#betmc_total_durability_00 - #betmc_total_durability_1)",
        "target_property_name": "#betmc_total_durability_10"
      },
      {
        "binding_type": "view",
        "source_property_name": "(1000 * ((#betmc_total_durability_10 > 1999) + (#betmc_total_durability_10 > 2999) + (#betmc_total_durability_10 > 3999) + (#betmc_total_durability_10 > 4999) + (#betmc_total_durability_10 > 5999) + (#betmc_total_durability_10 > 6999) + (#betmc_total_durability_10 > 7999) + (#betmc_total_durability_10 > 8999) + (#betmc_total_durability_10 > 999)))",
        "target_property_name": "#betmc_total_durability_2"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#betmc_total_durability_10 - #betmc_total_durability_2)",
        "target_property_name": "#betmc_total_durability_20"
      },
      {
        "binding_type": "view",
        "source_property_name": "(100 * ((#betmc_total_durability_20 > 199) + (#betmc_total_durability_20 > 299) + (#betmc_total_durability_20 > 399) + (#betmc_total_durability_20 > 499) + (#betmc_total_durability_20 > 599) + (#betmc_total_durability_20 > 699) + (#betmc_total_durability_20 > 799) + (#betmc_total_durability_20 > 899) + (#betmc_total_durability_20 > 99)))",
        "target_property_name": "#betmc_total_durability_3"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#betmc_total_durability_20 - #betmc_total_durability_3)",
        "target_property_name": "#betmc_total_durability_30"
      },
      {
        "binding_type": "view",
        "source_property_name": "(10 * ((#betmc_total_durability_30 > 19) + (#betmc_total_durability_30 > 29) + (#betmc_total_durability_30 > 39) + (#betmc_total_durability_30 > 49) + (#betmc_total_durability_30 > 59) + (#betmc_total_durability_30 > 69) + (#betmc_total_durability_30 > 79) + (#betmc_total_durability_30 > 89) + (#betmc_total_durability_30 > 9)))",
        "target_property_name": "#betmc_total_durability_4"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#betmc_total_durability_30 - #betmc_total_durability_4)",
        "target_property_name": "#betmc_total_durability_40"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#betmc_total_durability_40 > 1) + (#betmc_total_durability_40 > 2) + (#betmc_total_durability_40 > 3) + (#betmc_total_durability_40 > 4) + (#betmc_total_durability_40 > 5) + (#betmc_total_durability_40 > 6) + (#betmc_total_durability_40 > 7) + (#betmc_total_durability_40 > 8) + (#betmc_total_durability_40 > 0))",
        "target_property_name": "#betmc_total_durability_5"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#betmc_total_durability_1 + #betmc_total_durability_2 + #betmc_total_durability_3 + #betmc_total_durability_4 + #betmc_total_durability_5)",
        "target_property_name": "#betmc_total_durability_value"
      },
      {
