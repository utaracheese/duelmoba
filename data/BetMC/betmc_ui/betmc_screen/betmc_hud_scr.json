{
  "namespace": "betmc_hud",

  "betmc_hud_label@betmc_config.betmc_main_config": {
    "type": "label",
    "anchor_from": "center",
    "anchor_to": "center",
    "font_type": "$betmc_label_font_type",
    "backup_font_type": "$betmc_label_font_type",
    "$betmc_font_scale_factor|default": 0.75,
    "font_scale_factor": "$betmc_font_scale_factor",
    "$betmc_hud_text_offset|default": [ 2, -2 ],
    "offset": "$betmc_hud_text_offset",
    "$betmc_label_color|default": "$chat_text_color",
    "color": "$betmc_label_color",
    "shadow": false
  },

  "betmc_hud_label_02@betmc_config.betmc_main_config": {
    "type": "label",
    "font_type": "$betmc_label_font_type",
    "backup_font_type": "$betmc_label_font_type",
    "$betmc_font_scale_factor|default": 0.75,
    "font_scale_factor": "$betmc_font_scale_factor",
    "$betmc_hud_text_offset|default": [ 2, -2 ],
    "offset": "$betmc_hud_text_offset",
    "$betmc_label_color|default": "$chat_text_color",
    "color": "$betmc_label_color",
    "shadow": false
  },

  "betmc_item_renderer@betmc_config.betmc_main_config": {
    "type": "custom",
    "renderer": "inventory_item_renderer",
    "size": [ 16, 16 ]
  },

  "betmc_progress_text_label@betmc_hud.betmc_hud_label_02": {
    "text": "#level_number",
    "$betmc_hud_text_offset": [ 0, -2 ],
    "color": "$experience_text_color",
    "anchor_from": "top_middle",
    "anchor_to": "bottom_middle",
    "bindings": [
      {
        "binding_name": "#level_number",
        "binding_type": "global"
      },
      {
        "binding_name": "#level_number_visible",
        "binding_type": "global",
        "binding_name_override": "#visible"
      }
    ]
  },

  "betmc_item_text_label@betmc_hud.betmc_hud_label_02": {
    "$text_binding|default": "#item_text",
    "$betmc_hud_text_offset": [ 0, -1 ],
    "max_size": [ 200, "default" ],
    "text_alignment": "center",
    "layer": 31,
    "color": "$text_color",
    "text": "#text",
    "alpha": "@hud.anim_item_name_text_alpha_in",
    "enable_profanity_filter": false,
    "bindings": [
      {
        "binding_name": "$text_binding",
        "binding_name_override": "#text"
      }
    ]
  },

  "betmc_ccorc_panel@betmc_common.empty_panel": {
    "controls": [
      { "betmc_ccorc_stack@betmc_hud.betmc_ccorc_stack": {} }
    ]
  },

  // BETMC CCORC
  "betmc_ccorc_stack@betmc_common.betmc_stack_horizontal_with_controls": {
    "$betmc_stack_horizontal_with_controls_size": [ 48, 16 ],
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "variables": [
      {
        "requires": "$pocket_screen",
        "offset": [ 0, 20 ]
      }
    ],
    "$betmc_stack_horizontal_controls": [
      { "compass@betmc_hud.betmc_item_renderer": { "property_bag": { "#item_id_aux": "$betmc_compass_id_aux" }} },
      { "recovery_compass@betmc_hud.betmc_item_renderer": { "property_bag": { "#item_id_aux": "$betmc_recovery_compass_id_aux" }} },
      { "clock@betmc_hud.betmc_item_renderer": { "property_bag": { "#item_id_aux": "$betmc_clock_id_aux" }} }
    ]
  },

    // BETMC BOTTOM CHAT
  "betmc_chat_panel@betmc_common.empty_panel": {
    "clips_children": true,
    "anchor_from": "bottom_left",
    "anchor_to": "bottom_left",
    "size": [ "100%", "100%c" ],
    "max_size": [ "100%", "50%" ],
    "offset": [ 0, -45 ],
    "controls": [
      {
        "stack_panel@betmc_common.empty_stack_panel": {
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "factory": {
            "name": "chat_item_factory",
            "max_children_size": 50,
            "control_ids": {
              "chat_item": "chat_item@betmc_hud.chat_grid_item"
            }
          }
        }
      }
    ]
  },

  "chat_grid_item@betmc_common.empty_panel": {
    "layer": 1,
    "size": [ "100% - 2px", "100%c + 1px" ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "anims": [ "@betmc_anim.betmc_chat_grid_anim_stack", "@betmc_anim.betmc_chat_grid_anim_stack_start" ],
    "bindings": [
      {
        "binding_name": "(not #on_new_death_screen)",
        "binding_name_override": "#visible"
      }
    ],
    "controls": [
      {
        "chat_background@betmc_common.empty_image": {
          "texture": "betmc_res/betmc_ui_textures/betmc_black_textures",
          "alpha": 0.4,
          "size": [ "100%", "100%c" ],
          "anims": [ "@betmc_anim.betmc_chat_bg_anim_start" ],
          "controls": [
            {
              "betmc_time_out_chat_bg@betmc_common.empty_image": {
                "anchor_from": "bottom_left",
                "anchor_to": "bottom_left",
                "texture": "betmc_res/betmc_ui_textures/betmc_white_textures",
                "anims": [ "@betmc_anim.betmc_chat_timeout_bg_anim" ]
              }
            },
            {
              "chat_text@betmc_hud.chat_label": {
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [ 2, 0 ]
              }
            }
          ]
        }
      }
    ]
  },

  "chat_label@betmc_hud.betmc_hud_label": {
    "layer": 31,
    "text": "#text",
    "size": [ "100%", "default" ],
    "localize": false,
    "color": "$chat_text_color",
    "line_padding": "$chat_line_spacing",
    "anims": [ "@hud.anim_chat_txt_wait" ],
    "bindings": [
      {
        "binding_name": "#chat_text",
        "binding_name_override": "#text",
        "binding_type": "collection",
        "binding_collection_name": "chat_text_grid",
        "binding_condition": "once"
      }
    ]
  },

  // BETMC PLAYER LIST HUD
  "betmc_player_list_image": {
    "type": "image",
    "size": [ 10, 10 ],
    "texture_file_system": "#texture_source",
    "bindings": [
      {
        "binding_name": "#texture",
        "binding_type": "collection",
        "binding_collection_name": "players_collection"
      },
      {
        "binding_name": "#texture_source",
        "binding_name_override": "#texture_file_system",
        "binding_type": "collection",
        "binding_collection_name": "players_collection"
      },
      {
        "binding_name": "#gamerpic_visible",
        "binding_type": "collection",
        "binding_collection_name": "players_collection",
        "binding_name_override": "#visible"
      }
    ]
  },

  "betmc_player_list_label": {
    "type": "label",
    "anchor_from": "center",
    "anchor_to": "center",
    "enable_profanity_filter": false,
    "color": "$chat_text_color",
    "text": "#gamertag",
    "font_type": "smooth",
    "shadow": true,
    "layer": 1,
    "bindings": [
      {
        "binding_name": "#gamertag",
        "binding_type": "collection",
        "binding_collection_name": "players_collection"
      }
    ]
  },

  "betmc_player_list_panel@betmc_common.empty_panel": {
    "size": [ "100%cm", "100%cm" ],
    "max_size": [ "100%cm", 166 ],
    "clips_children": true,
    "controls": [
      { "betmc_player_list_main@betmc_hud.betmc_player_list_main": {} }
    ]
  },

  "betmc_player_list_main@betmc_common.empty_image": {
    "size": [ "100%cm + 2px", "100%cm + 2px" ],
    "texture": "textures/ui/Black",
    "alpha": 0.4,
    "controls": [
      { "betmc_player_list_grid@betmc_hud.betmc_player_list_grid": {} }
    ]
  },

  "betmc_player_list_grid@betmc_common.empty_grid": {
    "size": [ 125, "100%c" ],
    "grid_dimensions": [ 3, 1 ],
    "grid_item_template": "betmc_hud.betmc_player_list_items_panel",
    "grid_dimension_binding": "#players_grid_dimension",
    "collection_name": "players_collection",
    "bindings": [
      {
        "binding_name": "#players_grid_dimension",
        "binding_condition": "always"
      }
    ]
  },

  "betmc_player_list_items_panel@betmc_common.empty_panel": {
    "size": [ 125, "100%cm + 1px" ],
    "controls": [
      { "betmc_player_list_items_stack@betmc_hud.betmc_player_list_items_stack": {} }
    ]
  },

  "betmc_player_list_items_stack@betmc_common.horizontal_stack_panel": {
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [ "100%cm", "100%cm" ],
    "controls": [
      { "betmc_player_list_image@betmc_hud.betmc_player_list_image": {} },
      {
        "betmc_padding@betmc_common.empty_panel": {
          "size": [ 1.5, 0 ]
        }
      },
      { "betmc_player_list_label@betmc_hud.betmc_player_list_label": {} }
    ]
   },

  // BETMC MAINHAND DURABILITY | (BASE CODE BY: ASAKI ZUKI)
  "betmc_hud_root_panel@betmc_common.empty_panel": {
    "controls": [
      { "betmc_mainhand_durability_collection@betmc_hud.betmc_mainhand_durability_collection": {} },
      { "betmc_ccorc_panel@betmc_hud.betmc_ccorc_panel": {} },
      {
        "betmc_inventory_overlay_panel@betmc_hud.betmc_inventory_overlay_panel": {
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "inventory_hud_pc_toggle",
              "source_property_name": "#ts",
              "target_property_name": "#pc_toggle"
            },
            {
              "binding_type": "view",
              "source_control_name": "inventory_hud_mobile_toggle",
              "source_property_name": "#ts",
              "target_property_name": "#mobile_toggle"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#pc_toggle or #mobile_toggle)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "inventory_hud_pc_toggle@betmc_common.empty_toggle": {
          "size": [ 0, 0 ],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "always_listen_to_input": true,
          "button_mappings": [
            {
              "from_button_id": "button.scoreboard",
              "to_button_id": "button.menu_select",
              "mapping_type": "global"
            }
          ],
          "bindings": [
            {
              "binding_name": "#inventory_touch_button",
              "binding_type": "global"
            },
            {
              "binding_type": "view",
              "source_property_name": "((not #inventory_touch_button) and #toggle_state)",
              "target_property_name": "#ts"
            }
          ]
        }
      }
    ]
  },

